# Frontend Environment Variables (Only Public/Client Keys)
VITE_BACKEND_URL=http://localhost:4000

# Razorpay public key only (never put the secret here). Prefer rzp_test_* for local testing.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Supabase Public Client Credentials (Get these from Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
