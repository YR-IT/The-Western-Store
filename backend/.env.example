# ─── ImageKit Credentials ───────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_public_key_here
IMAGEKIT_PRIVATE_KEY=your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ─── Supabase Credentials ───────────────────────────────────
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Server-Side Admin Authentication Credentials ──────────
ADMIN_EMAIL=your_secure_admin_email@domain.com
ADMIN_PASSWORD=your_secure_random_admin_password
# JWT Secret for signing Admin session tokens (generate with: openssl rand -base64 64)
JWT_SECRET=your_long_random_jwt_secret_here

# ─── Cashfree Payment Gateway Credentials ───────────────────
# Get keys from Cashfree Dashboard → Payment Gateway → Developers → API Keys
# Sandbox keys start with TEST_; Production keys start with PROD_
CASHFREE_APP_ID=TEST_your_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=SANDBOX
# Frontend: set VITE_CASHFREE_MODE=production on Vercel for live payments
PAYMENT_EXPIRY_MINUTES=30

# ─── Server Config ──────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
