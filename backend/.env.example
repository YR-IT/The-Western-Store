# ─── ImageKit Credentials ───────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_public_key_here
IMAGEKIT_PRIVATE_KEY=your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ─── Supabase Credentials ───────────────────────────────────
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Server-Side Admin Authentication Credentials ──────────
# Keeps admin credentials 100% private on the server — NEVER in browser JS!
ADMIN_EMAIL=your_secure_email_2026
ADMIN_PASSWORD=your_secure_password_2026
ADMIN_SECRET=westernstore_admin_2026

# ─── Server Config ──────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
