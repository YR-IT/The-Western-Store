# ─── ImageKit Credentials ───────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_public_key_here
IMAGEKIT_PRIVATE_KEY=your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ─── Supabase Credentials ───────────────────────────────────
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Server-Side Admin Authentication Credentials ──────────
ADMIN_EMAIL=your_secure_admin_email@domain.com
ADMIN_PASSWORD=your_secure_random_admin_password
# JWT Secret for signing Admin session tokens (generate with: openssl rand -base64 64)
JWT_SECRET=your_long_random_jwt_secret_here

# ─── Razorpay Payment Gateway Credentials ──────────────────
# [OWNER: Provide Razorpay credentials from Razorpay Dashboard]
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
PAYMENT_EXPIRY_MINUTES=30

# ─── Server Config ──────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
